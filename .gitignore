# ============================================================
# Dependencias
# ============================================================
node_modules/
bower_components/
jspm_packages/

# ============================================================
# Variables de entorno y secretos
# Conserva en Git solamente las plantillas sin credenciales.
# ============================================================
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
*.local

# Claves, certificados y credenciales
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
credentials.json
service-account*.json

# ============================================================
