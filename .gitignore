# ============================================================
dist/
build/
out/
public/build/
.output/
.vercel/
.netlify/

# Angular
.angular/
.angular/cache/

# React / Next.js / Nuxt / Vite
.next/
.nuxt/
.vite/
.vinxi/
.turbo/
.parcel-cache/

# TypeScript
*.tsbuildinfo

